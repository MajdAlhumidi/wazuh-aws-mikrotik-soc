<!--
  Custom Detection Rules for MikroTik RouterOS Network & Perimeter Defense
  Location: /var/ossec/etc/rules/custom_rules.xml (or local_rules.xml)
  IDs Range: 100100 - 100106
-->

<group name="mikrotik,network_security,">

  <!-- Base Rule: Catch all MikroTik Syslog logs -->
  <rule id="100100" level="0">
    <program_name>system|mikrotik|routeros</program_name>
    <description>Grouping rule for MikroTik RouterOS messages.</description>
  </rule>

  <!-- 1. Authentication: Single Login Failure -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <match>login failure|authentication failed</match>
    <description>MikroTik: User authentication failure detected (Winbox/SSH/WebFig).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- 2. Authentication: Brute Force Attack Detection -->
  <rule id="100102" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100101</if_matched_sid>
    <description>MikroTik: Potential Brute Force attack detected (Multiple failed logins from source).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <!-- 3. Perimeter: WAN Management Port Access Attempt -->
  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <match>FW_WAN_MGMT_BLOCKED</match>
    <description>MikroTik: Blocked attempt to access management ports (Winbox/SSH/HTTP) from WAN interface.</description>
    <mitre>
      <id>T1190</id>
      <id>T1046</id>
    </mitre>
    <group>firewall_drop,reconnaissance,</group>
  </rule>

  <!-- 4. Reconnaissance: Port Scanning / SYN Flood Activity -->
  <rule id="100104" level="10" frequency="10" timeframe="60">
    <if_sid>100100</if_sid>
    <match>FW_TCP_SCAN_DETECTED</match>
    <description>MikroTik: High-frequency connection attempts detected (Possible TCP Port Scan or SYN flood).</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>port_scan,reconnaissance,</group>
  </rule>

  <!-- 5. Network Integrity: Dropped Invalid Packets Spike -->
  <rule id="100105" level="7" frequency="15" timeframe="60">
    <if_sid>100100</if_sid>
    <match>FW_DROP_INVALID</match>
    <description>MikroTik: Burst of invalid packets dropped by firewall filters (Malformed traffic or evasion attempt).</description>
    <mitre>
      <id>T1562.004</id>
    </mitre>
    <group>firewall_drop,anomalous_traffic,</group>
  </rule>

  <!-- 6. Audit: Administrative Configuration Changes -->
  <rule id="100106" level="4">
    <if_sid>100100</if_sid>
    <match>logged in|user added|by admin|system,info</match>
    <description>MikroTik: Administrative session activity or configuration modification logged.</description>
    <mitre>
      <id>T1078</id>
      <id>T1098</id>
    </mitre>
    <group>audit,config_change,</group>
  </rule>

</group>